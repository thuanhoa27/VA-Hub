# ============================================================================
# Copy file nay thanh .env.local (chay may) hoac dan vao Vercel > Settings >
# Environment Variables (khi deploy).
#
# Lay 2 gia tri nay tai: Supabase Dashboard > Project Settings > API
# ============================================================================

# URL project Supabase, dang https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Key "anon / public". Key nay LO RA TRINH DUYET la binh thuong — RLS trong
# 0001_schema.sql moi la lop bao ve that (anon chi doc reference + ghi analysis_run).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TUYET DOI KHONG dat service_role key o day. Bien NEXT_PUBLIC_* duoc nhung
# thang vao bundle JS ma ai cung xem duoc.

# Hien o goc man hinh, tien truy vet khi co bug. Khong bat buoc.
NEXT_PUBLIC_APP_VERSION=1.0.0
